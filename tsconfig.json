{
  "compilerOptions": {
    // Capped by the `engines` floor, not by the dev box: ES2022 is all Node 20 fully
    // provides. `test/toolchain.test.ts` fails if this outruns the floor.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // tools/ and analysis/ are JavaScript so they run on the Node 20 floor with no build
    // step. checkJs holds them to the same strict settings as src/ via JSDoc types.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["analysis", "config", "src", "test", "tools"]
}
